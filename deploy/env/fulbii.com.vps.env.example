APP_NAME=fulbii
APP_ENV=production
APP_KEY=base64:REEMPLAZAR_CON_APP_KEY_REAL
APP_DEBUG=false
APP_URL=https://fulbii.com
APP_LINK_BASE_URL=https://fulbii.com
ANDROID_STORE_URL=
IOS_STORE_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fulbii
DB_USERNAME=fulbii_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_REAL

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://fulbii.com

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@fulbii.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SOCIAL_AUTH_TRUSTED_MODE=false
APPLE_AUTH_REQUIRE_NONCE=true
APPLE_AUTH_AUDIENCES=
SANCTUM_EXPIRATION_MINUTES=43200
SANCTUM_MAX_TOKENS_PER_USER=5
WATCH_SESSION_CREATE_PER_MINUTE=6
WATCH_SAMPLE_BATCHES_PER_MINUTE=12
WATCH_EVENT_BATCHES_PER_MINUTE=20
WATCH_MAX_SAMPLES_PER_BATCH=500
WATCH_MAX_SAMPLES_PER_SESSION=10000
WATCH_RETENTION_DAYS=30
# Cliente Web principal del proyecto Firebase actual (Android).
GOOGLE_CLIENT_ID=706272816323-4bnqeamoe4qucq7the2oscmq8si5huep.apps.googleusercontent.com
# Durante la migración acepta también el cliente Web usado por builds iOS anteriores.
GOOGLE_CLIENT_IDS=14247591730-nru6ieshjvg4fp480rheupp2fjevkq2s.apps.googleusercontent.com,706272816323-4bnqeamoe4qucq7the2oscmq8si5huep.apps.googleusercontent.com
APPLE_CLIENT_ID=com.fulbii

PUSH_DRIVER=fcm
FCM_PROJECT_ID=fulbii
FCM_SERVICE_ACCOUNT_PATH=/etc/fulbii/firebase-service-account.json
FCM_SCOPE=https://www.googleapis.com/auth/firebase.messaging
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
# Legacy (no usado por FCM v1):
FCM_SERVER_KEY=

APP_LINK_IOS_APP_IDS=H22GQQX4KT.com.fulbii
APP_LINK_ANDROID_PACKAGE_NAME=com.fulbii.fulbii_app
APP_LINK_ANDROID_SHA256_CERT_FINGERPRINTS=REEMPLAZAR_SHA256_DEBUG,REEMPLAZAR_SHA256_RELEASE,REEMPLAZAR_SHA256_PLAY_SIGNING

MODERATION_AUTO_SUSPEND_DAYS=30
MODERATION_STAFF_BLOCKED_REVOKE_REASON_CODES=auto_3_strikes,safety_critical,platform_abuse
MEDIA_FFMPEG_BINARY=/usr/bin/ffmpeg
MEDIA_FFPROBE_BINARY=/usr/bin/ffprobe
PROFILE_CLIP_MAX_OUTPUT_BYTES=1362944
PROFILE_CLIP_TRANSCODE_TIMEOUT_SECONDS=45
